<?xml version="1.0" encoding="utf-8"?>
<!--
  Data Collector 2.0 - IIS site web.config (generated by Deploy-DataCollector.ps1).
  IIS runs the Python WSGI app directly through FastCGI (wfastcgi); there is no reverse
  proxy and no second HTTP server. Contains paths only - never secrets. Secrets are read by
  the app from the restricted file named in DC_ENV_FILE.
  Placeholders: {{PYTHON}} {{WFASTCGI}} {{APP_DIR}} {{WEB_DIST}} {{ENV_FILE}} {{RELEASE}}
-->
<configuration>
  <appSettings>
    <add key="WSGI_HANDLER" value="deploy.iis.wsgi.application" />
    <add key="PYTHONPATH" value="{{APP_DIR}}" />
    <add key="DC_ENV_FILE" value="{{ENV_FILE}}" />
    <add key="WEB_DIST_DIR" value="{{WEB_DIST}}" />
    <add key="DC_RELEASE" value="{{RELEASE}}" />
    <add key="PYTHONDONTWRITEBYTECODE" value="1" />
  </appSettings>
  <system.webServer>
    <handlers>
      <clear />
      <add name="DataCollectorPythonFastCGI" path="*" verb="*" modules="FastCgiModule"
           scriptProcessor="{{PYTHON}}|{{WFASTCGI}}"
           resourceType="Unspecified" requireAccess="Script" />
    </handlers>
    <modules>
      <!-- WebDAV would answer PUT/DELETE itself before the app sees them -->
      <remove name="WebDAVModule" />
    </modules>
    <defaultDocument enabled="false" />
    <directoryBrowse enabled="false" />
    <httpErrors existingResponse="PassThrough" />
    <security>
      <requestFiltering allowDoubleEscaping="false" allowHighBitCharacters="false" removeServerHeader="true">
        <!-- 55 MB: import payload limit (50 MB) plus multipart/JSON overhead -->
        <requestLimits maxAllowedContentLength="57671680" maxUrl="4096" maxQueryString="4096" />
        <hiddenSegments applyToWebDAV="true">
          <add segment=".git" />
          <add segment=".venv" />
          <add segment="venv" />
          <add segment=".env" />
          <add segment="secrets" />
          <add segment="__pycache__" />
          <add segment="node_modules" />
        </hiddenSegments>
        <fileExtensions allowUnlisted="true" applyToWebDAV="true">
          <add fileExtension=".env" allowed="false" />
          <add fileExtension=".pem" allowed="false" />
          <add fileExtension=".key" allowed="false" />
          <add fileExtension=".py" allowed="false" />
          <add fileExtension=".pyc" allowed="false" />
          <add fileExtension=".config" allowed="false" />
          <add fileExtension=".conf" allowed="false" />
          <add fileExtension=".bak" allowed="false" />
          <add fileExtension=".log" allowed="false" />
          <add fileExtension=".map" allowed="false" />
        </fileExtensions>
        <verbs allowUnlisted="false">
          <add verb="GET" allowed="true" />
          <add verb="HEAD" allowed="true" />
          <add verb="POST" allowed="true" />
          <add verb="PUT" allowed="true" />
          <add verb="PATCH" allowed="true" />
          <add verb="DELETE" allowed="true" />
          <add verb="OPTIONS" allowed="true" />
        </verbs>
      </requestFiltering>
    </security>
    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
        <add name="Strict-Transport-Security" value="max-age=31536000" />
      </customHeaders>
    </httpProtocol>
    <urlCompression doStaticCompression="false" doDynamicCompression="false" />
  </system.webServer>
</configuration>
