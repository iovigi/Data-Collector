{$DOMAIN:collector.example.com} {
    encode zstd gzip

    @mcp path /mcp* /.well-known/* /oauth/*
    handle @mcp {
        reverse_proxy mcp-http:8001 {
            flush_interval -1
        }
    }

    @bff path /api/auth/* /api/backend/*
    handle @bff {
        reverse_proxy web:3000
    }

    @api path /api/v1/* /health/*
    handle @api {
        reverse_proxy api:8000
    }

    handle {
        reverse_proxy web:3000
    }
}
