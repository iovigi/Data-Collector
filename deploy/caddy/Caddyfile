{$DOMAIN:collector.example.com} {
    encode zstd gzip

    @mcp path /mcp* /.well-known/* /oauth/*
    handle @mcp {
        reverse_proxy mcp-http:8001 {
            flush_interval -1
        }
    }

    # REST API, Python BFF (/api/auth, /api/backend), health and the Admin UI SPA are all
    # served by the Python app (data_collector.hosting.iis_app:build_application).
    handle {
        reverse_proxy api:8000
    }
}
