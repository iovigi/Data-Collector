# Data Collector 2.0 Environment Configuration
# Copy to .env and replace placeholders with secure values from your secret manager.

APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
LOG_LEVEL=INFO

MONGODB_URI=mongodb://localhost:27017/
MONGODB_DB=data_collector
REDIS_URL=redis://localhost:6379/0

# REQUIRED in production: >= 32 random characters
JWT_SECRET_KEY=replace-with-32-plus-char-random-secret-value
INTENT_SECRET_KEY=replace-with-32-plus-char-intent-secret-value

AUTH_ISSUER=https://auth.example.com/
AUTH_AUDIENCE=data-collector-api
MCP_PUBLIC_URL=https://collector.example.com/mcp
MCP_HOST=127.0.0.1
MCP_PORT=8001
MCP_ALLOW_WRITES=false

ALLOWED_ORIGINS=http://localhost:3000,https://chatgpt.com,https://claude.ai
RATE_LIMIT_READ_PER_MINUTE=60
RATE_LIMIT_WRITE_PER_MINUTE=30
MAX_QUERY_PAGE_SIZE=100
